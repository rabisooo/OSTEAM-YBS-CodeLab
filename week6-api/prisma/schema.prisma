generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  events Event[]
}

model Event {
  id Int @id @default(autoincrement())
  title String
  date DateTime
  done Boolean @default(false)
  organizer User? @relation(fields: [organizerId], references: [id])
  organizerId Int?
}
